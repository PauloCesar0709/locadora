# Copie este arquivo para ".env" (na pasta backend) e preencha. NÃO faça commit do .env.
#
# Supabase: Project Settings > Database > Connection string > "Session pooler" (JDBC)
# O usuário do pooler tem o formato postgres.<ref-do-projeto>
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.SEU_REF_DO_PROJETO
SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO

# Gere um segredo longo e aleatório (mínimo 32 caracteres), por exemplo: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-mais-de-32-caracteres

# Origem do front-end (Vite)
CORS_ORIGENS=http://localhost:5173
